{
  "expo": {
    "name": "MoiConnect",
    "slug": "moiconnect",
    "version": "1.1.7",
    "orientation": "portrait",
    "icon": "./assets/playstore_assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "17"
    },
    "android": {
      "icon": "./assets/playstore_assets/icon.png",
      "package": "com.amanikbt1.moiconnect",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ],
      "versionCode": 21
    },
    "notification": {
      "icon": "./assets/android-icon-monochrome.png",
      "color": "#15803d"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#15803d"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "1.9.24"
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "moiconnect",
    "owner": "sliver4",
    "extra": {
      "eas": {
        "projectId": "53c51c41-a1f7-40a0-8111-7b7cd97d968e"
      }
    }
  }
}
