{
  "cli": {
    "version": ">= 7.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "npmInstallCommand": "npm install --legacy-peer-deps"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "npmInstallCommand": "npm install --legacy-peer-deps"
    },
    "production": {
      "developmentClient": false,
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "npmInstallCommand": "npm install --legacy-peer-deps"
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "closed"
      }
    }
  }
}
