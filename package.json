{
  "name": "mobile",
  "version": "3.0.0",
  "main": "index.js",
  "scripts": {
    "start": "npm run generate:stickers && npm run generate:pdfjs && expo start --offline",
    "generate:stickers": "node scripts/generate-sticker-manifest.js",
    "generate:pdfjs": "node scripts/generate-pdfjs-assets.js",
    "build": "npm run generate:stickers && npm run generate:pdfjs && npm --prefix packages/shared run build && npx expo export -p web -c",
    "android": "npm run generate:stickers && npm run generate:pdfjs && expo run:android",
    "ios": "npm run generate:stickers && expo run:ios",
    "postinstall": "npm --prefix packages/shared run build && node scripts/patch-expo-modules.js && node scripts/generate-pdfjs-assets.js",
    "web": "npm run generate:pdfjs && expo start --web --offline --port 8082",
    "eas": "eas"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "@livekit/react-native": "^3.1.0",
    "@livekit/react-native-expo-plugin": "^1.1.0",
    "@livekit/react-native-webrtc": "^150.1.0",
    "@moi/shared": "file:./packages/shared",
    "@react-native-google-signin/google-signin": "^12.2.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/core": "^6.4.17",
    "@react-navigation/elements": "^1.3.30",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@tanstack/react-query": "^5.40.0",
    "expo": "~58.0.14",
    "expo-asset": "~58.0.16",
    "expo-auth-session": "~58.0.13",
    "expo-build-properties": "~58.0.11",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.13",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.5",
    "expo-router": "~58.0.23",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.19",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-web-browser": "~58.0.6",
    "graphql": "^16.8.1",
    "livekit-client": "^2.23.0",
    "pdfjs-dist": "^3.11.174",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.0",
    "typescript": "~5.9.3"
  },
  "private": true
}
